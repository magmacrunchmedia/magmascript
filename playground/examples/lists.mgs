// lists.mgs — Lists, comprehensions, and methods

// Create a list
colors = ["red", "green", "blue", "yellow"]
print(f"Colors: {colors}")
print(f"Length: {len(colors)}")

// Check membership
print(f"Has red? {"red" in colors}")
print(f"Has purple? {"purple" in colors}")

// List comprehension — square numbers
squares = [x * x for x in range(1, 11)]
print(f"Squares: {squares}")

// Filtered comprehension — even numbers only
evens = [x for x in range(20) if x % 2 == 0]
print(f"Evens: {evens}")

// Build a list with append
fibs = [0, 1]
for i in range(8) {
    next = fibs[len(fibs) - 1] + fibs[len(fibs) - 2]
    fibs = fibs + [next]
}
print(f"Fibonacci list: {fibs}")

// Nested lists
matrix = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
print(f"Matrix: {matrix}")
print(f"Center element: {matrix[1][1]}")
