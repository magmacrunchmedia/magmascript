// strings.mgs — String methods and f-strings

// Basic string operations
greeting = "Hello, MagmaScript!"
print(f"Greeting: {greeting}")
print(f"Length: {len(greeting)}")

// Case methods
print(greeting.upper())
print(greeting.lower())

// Contains
print(f"Contains 'Script'? {greeting.contains("Script")}")
print(f"Contains 'Python'? {greeting.contains("Python")}")

// Replace
shouty = greeting.replace("Hello", "HI")
print(f"Shouty: {shouty}")

// Split and join
csv = "one,two,three,four"
parts = csv.split(",")
print(f"Parts: {parts}")

joined = " | ".join(parts)
print(f"Joined: {joined}")

// String interpolation with expressions
for i in range(1, 6) {
    if i == 1 {
        print(f"{'*' * i} 1 star")
    } else {
        print(f"{'*' * i} {i} stars")
    }
}

// Strip whitespace
padded = "   hello   "
print(f"Before strip: [{padded}]")
print(f"After strip: [{padded.strip()}]")
