// fibonacci.mgs — Recursion and loops

// Recursive fibonacci
fib = fn(n) {
    if n <= 1 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

// Print first 10 fibonacci numbers
for i in range(10) {
    print(f"fib({i}) = {fib(i)}")
}

// Factorial with a while loop
factorial = fn(n) {
    result = 1
    i = 2
    while i <= n {
        result = result * i
        i = i + 1
    }
    return result
}

print(f"10! = {factorial(10)}")

// Sum of a range
total = 0
for i in range(1, 11) {
    total = total + i
}
print(f"Sum 1..10 = {total}")
