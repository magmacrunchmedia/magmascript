#!/usr/bin/env bash
# magmascript Pi wrapper — shorthand for Pi management
#
# Usage:
#   pi status
#   pi logs arcade-chat
#   pi restart arcade-chat
#   pi info
#   pi traffic
#
# Install:
#   chmod +x cli/pi
#   ln -s $(pwd)/cli/pi ~/bin/pi

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

# If magmascript is installed as a package, use it
if command -v magmascript &>/dev/null; then
    exec magmascript pi "$@"
fi

# Otherwise, run from source
exec python3 -m magmascript.cli pi "$@"
