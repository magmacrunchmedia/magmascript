// fibonacci.mgs — Fibonacci sequence example

// Recursive fibonacci
fib = fn(n) {
    if n <= 1 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

// Print first 10 fibonacci numbers
for i in range(10) {
    print(f"fib({i}) = {fib(i)}")
}

// Factorial
factorial = fn(n) {
    result = 1
    i = 2
    while i <= n {
        result = result * i
        i = i + 1
    }
    return result
}

print(f"10! = {factorial(10)}")
