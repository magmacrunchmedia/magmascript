// top-scores.mgs — MagmaCrunch Arcade leaderboards
//
// Usage:
//   magmascript run top-scores.mgs              # All games overview
//   magmascript run top-scores.mgs tetris       # Full leaderboard for one game

script_args = args()
game = ""

if len(script_args) > 0 {
    game = script_args[0]
}

if game == "" {
    // Mode 1: All games overview
    boards = mcp.scoreboards()

    print("MagmaCrunch Arcade — Leaderboards")
    print("==================================")
    print("")

    for b in boards {
        if b.top != none {
            print(f"{b.game}")
            print(f"  {b.entries} entries | Top: {b.top.initials} with {b.top.score}")
        } else {
            print(f"{b.game}")
            print(f"  {b.entries} entries | No scores yet")
        }
        print("")
    }
} else {
    // Mode 2: Single game leaderboard
    boards = mcp.scoreboards()
    found = false

    for b in boards {
        if b.game.lower() == game.lower() or b.game_id.lower() == game.lower() {
            found = true
            scores = mcp.scores(b.game_id, 20)

            print(f"{b.game} — Leaderboard")
            print("=" * 30)
            print("")

            i = 1
            for s in scores {
                level_str = ""
                if s.level != none {
                    level_str = f" (Lv{s.level})"
                }
                print(f"  {i}. {s.initials} — {s.score}{level_str}")
                i = i + 1
            }

            print("")
            print(f"Total entries: {b.entries}")
        }
    }

    if found == false {
        print(f"Game not found: {game}")
        print("")
        print("Available games:")
        for b in boards {
            print(f"  {b.game} ({b.game_id})")
        }
    }
}
